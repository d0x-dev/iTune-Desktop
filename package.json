{
  "name": "itune-desktop",
  "version": "1.0.0",
  "description": "iTune - Standalone YouTube Music Desktop Player",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron electron/main.js --dev\"",
    "electron:build": "vite build && electron-builder --publish never",
    "electron:portable": "vite build && electron-builder --win portable --publish never",
    "electron:nsis": "vite build && electron-builder --win nsis --publish never",
    "electron:windows": "vite build && electron-builder --win nsis portable --publish never",
    "electron:mac": "vite build && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "electron:linux": "vite build && electron-builder --linux AppImage deb --publish never",
    "electron:release": "vite build && electron-builder --win nsis portable --publish never",
    "start": "electron electron/main.js"
  },
  "build": {
    "appId": "com.darkxvenom.itune.desktop",
    "productName": "iTune Desktop",
    "afterPack": "build/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "nsis": {
      "artifactName": "iTune-Desktop-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "iTune-Desktop-Portable-${version}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "public/app-icon.png",
      "category": "public.app-category.music",
      "target": ["dmg", "zip"]
    },
    "linux": {
      "icon": "public/app-icon.png",
      "category": "AudioVideo",
      "maintainer": "iTune Project",
      "synopsis": "iTune music player",
      "target": ["AppImage", "deb"]
    }
  },
  "keywords": [
    "youtube-music",
    "music-player",
    "itune",
    "desktop",
    "electron"
  ],
  "author": "iTune",
  "license": "GPL-3.0",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.16.0",
    "play-dl": "^1.9.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
