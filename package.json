{
  "name": "itune-desktop",
  "version": "1.0.0",
  "description": "iTune - Standalone YouTube Music Desktop Player",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron electron/main.js --dev\"",
    "electron:build": "vite build && electron-builder --win --dir",
    "electron:portable": "vite build && electron-builder -c.win.signAndEditExecutable=false --win portable",
    "start": "electron electron/main.js"
  },
  "build": {
    "appId": "com.darkxvenom.itune.desktop",
    "productName": "iTune Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "dir",
        "portable"
      ]
    }
  },
  "keywords": [
    "youtube-music",
    "music-player",
    "itune",
    "desktop",
    "electron"
  ],
  "author": "iTune",
  "license": "GPL-3.0",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "play-dl": "^1.9.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
